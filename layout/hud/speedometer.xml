<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	
	<scripts>
		<include type="module" src="file://{scripts}/hud/speedometer.ts" />
	</scripts>

	<snippets>
		<snippet name="speedometer-entry">
			<Panel class="v-align-center h-align-center">
				<Panel id="SpeedometerContainer" class="speedometer">
					<Panel class="speedometer__main">
						<Panel id="SpeedometerDuckIcon" class="speedometer__duck-icon">
							<Label id="SpeedometerDuckStandDot" text="●" class="speedometer__duck-dot speedometer__duck-dot--stand" />
							<Label id="SpeedometerDuckProgressDot" text="●" class="speedometer__duck-dot speedometer__duck-dot--progress" />
							<Label id="SpeedometerDuckFullDot" text="●" class="speedometer__duck-dot speedometer__duck-dot--full" />
						</Panel>
						<Label id="SpeedometerLabel" text="" class="text-align-center" />
						<Panel id="SpeedometerIconSpacer" class="speedometer__duck-icon-spacer" />
						<Label id="SpeedometerComparisonLabel" text="" />
					</Panel>
					<Label id="SpeedometerYawSpeedLabel" text="" class="speedometer__yawspeed text-align-center" />
				</Panel>
			</Panel>
		</snippet>
	</snippets>

	<MomHudSpeedometer class="h-align-center">
		<Panel id="SpeedometersContainer" class="speedometers">
		</Panel>
	</MomHudSpeedometer>
</root>
